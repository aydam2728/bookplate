# Every value below has a usable default; this file documents what they are.
# Copy to .env only if you want to change something.
#
# Any key may instead be read from a file by setting <KEY>_FILE. That is how a
# secret should arrive: the environment is readable by anyone who can run
# "docker inspect", a mounted file is not.
#
#   BOOKPLATE_ADDR_FILE=/run/secrets/bookplate_addr
#
# Setting both forms for the same key is refused rather than silently resolved.

# Listen address. Keep it on every interface inside the container; the port
# mapping in compose.yaml decides what is reachable from outside.
BOOKPLATE_ADDR=:8080

# Database and cover cache. The only directory to back up.
BOOKPLATE_DATA_DIR=/data

# debug, info, warn or error.
BOOKPLATE_LOG_LEVEL=info
